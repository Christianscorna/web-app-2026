package views

import "fmt"
import db "ejemplo.com/tp-especial/db/sqlc"

templ SeleccionMaterias(materias []db.Materium) {
    <main class="seleccion-materias">
        <h1>Elegí tus materias</h1>
        <p>
            Seleccioná una o más materias para armar tu próxima partida.
        </p>

        <form action="/jugar" method="POST">
            <fieldset>
                <legend>Materias disponibles</legend>

                if len(materias) == 0 {
                    <p>Todavía no hay materias disponibles.</p>
                } else {
                    for _, m := range materias {
                        <label class="materia">
                            <input
                                type="checkbox"
                                name="materias"
                                value={ fmt.Sprint(m.IDMateria) }
                            />
                            <span>{ m.Nombre }</span>
                        </label>
                    }
                }
            </fieldset>

            <button type="submit">Empezar a jugar</button>
        </form>
    </main>
}
