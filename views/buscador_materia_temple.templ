package views

import (
	"fmt"

	db "ejemplo.com/tp-especial/db/sqlc"
)

// BuscadorMateriaJuego filtra el catálogo y permite sumar una materia.
templ BuscadorMateriaJuego(materias []db.Materium, seleccionadas []db.Materium, filtro string) {
	<section aria-labelledby="buscador-materias">
		<h2 id="buscador-materias">Elegí tus materias</h2>

		<form action="/jugar" method="GET">
			for _, elegida := range seleccionadas {
				<input type="hidden" name="materias" value={ fmt.Sprint(elegida.IDMateria) }/>
			}
			<label for="materia-busqueda">Buscar materia</label>
			<input id="materia-busqueda" name="q" type="search"
				value={ filtro } placeholder="p. ej.: Sistemas Operativos"
				autocomplete="off"/>
			<button type="submit">Buscar</button>
		</form>

		if len(materias) == 0 {
			<p>No hay materias que coincidan con la búsqueda.</p>
		} else {
			<ul class="catalogo-materias">
				for _, materia := range materias {
					<li>
						<span>{ materia.Nombre }</span>

						<form action="/jugar" method="POST">
							<input type="hidden" name="accion" value="agregar"/>
							<input type="hidden" name="q" value={ filtro }/>
							<input type="hidden" name="id_materia" value={ fmt.Sprint(materia.IDMateria) }/>
							for _, elegida := range seleccionadas {
								<input type="hidden" name="materias" value={ fmt.Sprint(elegida.IDMateria) }/>
							}
							<button type="submit" disabled?={ len(seleccionadas) >= 5 }>
								Agregar
							</button>
						</form>
					</li>
				}
			</ul>
		}
	</section>
}
