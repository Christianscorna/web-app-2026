package views

// Juego conserva una entrada pequeña para las referencias antiguas.
templ Juego(resultado string, rotacion int) {
	<section class="juego">
		<h1>Jugar</h1>
		<p>{ resultado }</p>
		<a href="/jugar">Abrir el juego</a>
	</section>
}

func claseRuleta(resultado string) string {
	if resultado == "" {
		return "rueda"
	}
	return "rueda girando"
}
